---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';

const certificates = (await getCollection('certificates')).sort((a, b) => a.data.order - b.data.order);
---

<BaseLayout
  title="Certificates | Sina Tavakoli"
  description="Certificates and training records for Sina Tavakoli across programming, data workflows, machine learning lifecycle, version control, and technical foundations."
>
  <section class="section page-hero">
    <div class="container">
      <p class="eyebrow">Certificates</p>
      <h1 class="section-title">Training and proof of practice.</h1>
      <p class="section-lede">
        A compact archive of training connected to the same foundation shown in the project work:
        programming, data handling, ML lifecycle thinking, version control, algorithms, and practical
        technical execution.
      </p>
    </div>
  </section>

  <section class="section-tight">
    <div class="container certificate-grid">
      {
        certificates.map((certificate) => (
          <article class="certificate-card card">
            <p>{certificate.data.topic}</p>
            <h2>{certificate.data.title}</h2>
            <span>{certificate.data.provider}</span>
            <a href={certificate.data.pdfUrl}>Open PDF</a>
          </article>
        ))
      }
    </div>
  </section>
</BaseLayout>

<style>
  .page-hero {
    padding-bottom: 38px;
  }

  .certificate-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 18px;
  }

  .certificate-card {
    min-height: 210px;
    padding: 24px;
  }

  .certificate-card p {
    margin: 0 0 12px;
    color: var(--accent-dark);
    font-size: 0.78rem;
    font-weight: 850;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .certificate-card h2 {
    margin: 0 0 12px;
    font-size: 1.45rem;
  }

  .certificate-card span {
    display: block;
    color: var(--muted);
    font-weight: 650;
  }

  .certificate-card a {
    display: inline-flex;
    margin-top: 28px;
    color: var(--accent-dark);
    font-weight: 850;
  }

  @media (max-width: 760px) {
    .certificate-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
