---
import { sitePath } from '../utils/paths';

interface Props {
  title: string;
  summary: string;
  category: string;
  coverImage: string;
  href: string;
  techStack: string[];
  githubUrl?: string;
  showTitle?: boolean;
}

const { title, summary, category, coverImage, href, techStack, githubUrl, showTitle = true } = Astro.props;
---

<article class="project-card card">
  <a class="project-image" href={sitePath(href)} aria-label={`Read ${title} case study`}>
    <img src={sitePath(coverImage)} alt={`${title} project cover`} loading="lazy" />
  </a>
  <div class="project-body">
    <p class="project-category">{category}</p>
    {showTitle && <h3><a href={href}>{title}</a></h3>}
    <p>{summary}</p>
    <ul class="tag-list" aria-label={`${title} tech stack`}>
      {techStack.slice(0, 5).map((tech) => <li class="tag">{tech}</li>)}
    </ul>
    <div class="project-actions">
      <a class="text-link" href={sitePath(href)}>Read case study</a>
      {githubUrl && <a class="text-link" href={githubUrl} target="_blank" rel="noreferrer">GitHub</a>}
    </div>
  </div>
</article>

<style>
  .project-card {
    overflow: hidden;
  }

  .project-image {
    display: block;
    aspect-ratio: 2 / 1;
    overflow: hidden;
    background: #fff;
  }

  .project-image img {
    width: 100%;
    height: 100%;
    object-fit: contain;
    pointer-events: none;
    user-select: none;
  }

  .project-body {
    display: flex;
    min-height: 285px;
    flex-direction: column;
    gap: 14px;
    padding: 22px;
  }

  .project-category {
    margin: 0;
    color: var(--accent-dark);
    font-size: 0.78rem;
    font-weight: 800;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  h3 {
    margin: 0;
    font-size: 1.32rem;
    line-height: 1.2;
  }

  p {
    margin: 0;
    color: var(--muted);
    line-height: 1.65;
  }

  .project-actions {
    display: flex;
    gap: 16px;
    margin-top: auto;
    padding-top: 6px;
  }

  .text-link {
    color: var(--accent-dark);
    font-weight: 800;
  }

  .text-link:hover {
    text-decoration: underline;
    text-underline-offset: 3px;
  }
</style>
